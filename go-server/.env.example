# ============================================================
# Shipyard Hub - Go Server Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Default admin credentials (used to seed the database on first run)
DEFAULT_ADMIN_USERNAME=superadmin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@shipyard.local

# JWT secret for authentication — CHANGE THIS IN PRODUCTION!
NEXTAUTH_SECRET=your_very_secure_random_secret_here_change_me

# Server port (default: 3000)
PORT=3000

# Database path
# Local development: ./shipyard.sqlite
# Docker/EasyPanel production: /data/shipyard.sqlite
DATABASE_PATH=/data/shipyard.sqlite

# Timezone
TZ=Asia/Jakarta

# Background workers (SIAGA sync, WO detail refresh, AI ETL).
# Set to true on a machine that shares the production database with the
# production server (e.g. a dev laptop) so only one instance runs them.
DISABLE_WORKERS=false

# Work order detail worker: every WO_DETAIL_INTERVAL_SECONDS it re-fetches up to
# WO_DETAIL_BATCH details (WO_DETAIL_CONCURRENCY in parallel) that are missing or
# changed in SIAGA (their updated_at differs from the stored detail).
# WO_OPEN_RESYNC_HOURS > 0 additionally re-checks open (not Level 5) WOs not
# fetched within that many hours; 0 (default) keeps SIAGA traffic minimal.
WO_DETAIL_INTERVAL_SECONDS=60
WO_DETAIL_BATCH=20
WO_DETAIL_CONCURRENCY=3
WO_OPEN_RESYNC_HOURS=0
